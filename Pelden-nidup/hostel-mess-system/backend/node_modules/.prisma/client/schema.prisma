generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ============================================
// MODELS
// ============================================

// User Model 
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  name           String
  rollNumber     String?  @unique
  role           String   @default("STUDENT") // "STUDENT" or "ADMIN"
  profilePicture String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feedbacks     Feedback[]
  votes         PollVote[]
  notifications Notification[]
  suggestions   Suggestion[]
  systemLogs    SystemLog[]

  @@map("users")
}

// Meal Plan 
model MealPlan {
  id          String   @id @default(cuid())
  day         String // "MONDAY", "TUESDAY", etc.
  mealType    String // "BREAKFAST", "LUNCH", "DINNER"
  name        String
  description String?
  price       Float?
  isActive    Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  specialMeals SpecialMeal[]
  feedbacks    Feedback[]

  @@unique([day, mealType])
  @@map("meal_plans")
}

// Special Meal
model SpecialMeal {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime @unique
  mealType    String // "REGULAR", "SPECIAL_MONDAY", "SPECIAL_THURSDAY"
  isActive    Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mealPlanId String?
  mealPlan   MealPlan? @relation(fields: [mealPlanId], references: [id])
  polls      Poll[]

  @@map("special_meals")
}

// Poll
model Poll {
  id            String   @id @default(cuid())
  question      String
  description   String?
  startDate     DateTime @default(now())
  endDate       DateTime
  status        String   @default("DRAFT") // "DRAFT", "ACTIVE", "CLOSED"
  isActive      Boolean  @default(true)
  pollType      String // "DIET_PREFERENCE", "MEAT_SELECTION"
  specialMealId String
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  specialMeal SpecialMeal  @relation(fields: [specialMealId], references: [id], onDelete: Cascade)
  options     PollOption[]
  votes       PollVote[]

  @@map("polls")
}

// Poll Option
model PollOption {
  id     String     @id @default(cuid())
  text   String
  value  String
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@unique([pollId, value])
  @@map("poll_options")
}

// Poll Vote
model PollVote {
  id       String   @id @default(cuid())
  userId   String
  pollId   String
  optionId String
  votedAt  DateTime @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([userId, pollId])
  @@map("poll_votes")
}

// Feedback
model Feedback {
  id           String    @id @default(cuid())
  userId       String
  rating       Int
  comment      String
  mealPlanId   String?
  status       String    @default("PENDING") // "APPROVED", "PENDING", "FLAGGED", "REJECTED"
  flaggedWords String
  reviewedBy   String?
  reviewedAt   DateTime?
  adminNote    String?
  isAnonymous  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealPlan MealPlan? @relation(fields: [mealPlanId], references: [id])

  @@index([status])
  @@index([userId])
  @@map("feedbacks")
}

// Suggestion
model Suggestion {
  id            String    @id @default(cuid())
  userId        String
  title         String
  description   String
  status        String    @default("PENDING") // "APPROVED", "PENDING", "FLAGGED", "REJECTED"
  flaggedWords  String
  reviewedBy    String?
  reviewedAt    DateTime?
  adminResponse String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("suggestions")
}

// Grocery Bill
model GroceryBill {
  id          String   @id @default(cuid())
  receiptUrl  String
  receiptName String
  totalAmount Float
  billDate    DateTime
  uploadedBy  String
  description String?
  mealCycle   String?
  fileSize    Int?
  fileType    String?
  items       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([billDate])
  @@map("grocery_bills")
}

// Cost Summary
model CostSummary {
  id              String   @id @default(cuid())
  cycleName       String   @unique
  startDate       DateTime
  endDate         DateTime
  totalCost       Float
  averageMealCost Float?
  totalMeals      Int?
  notes           String?
  generatedBy     String
  generatedAt     DateTime @default(now())

  @@map("cost_summaries")
}

// Notification
model Notification {
  id          String    @id @default(cuid())
  userId      String
  title       String
  message     String
  type        String // "MEAL_TIME_CHANGE", "SPECIAL_MEAL_UPDATE", etc.
  status      String    @default("UNREAD") // "READ", "UNREAD"
  metadata    String?
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  readAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([createdAt])
  @@map("notifications")
}

// Meal Time Setting
model MealTimeSetting {
  id          String   @id @default(cuid())
  mealType    String   @unique // "BREAKFAST", "LUNCH", "DINNER"
  time        String
  bufferTime  Int?
  description String?
  updatedBy   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("meal_time_settings")
}

// System Log
model SystemLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("system_logs")
}
